# Copy this file to `.dev.vars` for local `wrangler dev` if you want local secrets.
# Production secrets should be added with `wrangler secret put <NAME>`.

LOCAL_DEV_MODE=false
DEV_MOCK_USER_ID=local-dev-user
DEV_MOCK_USER_EMAIL=local-dev@gpay.local
DEV_MOCK_USER_ROLE=admin
FRONTEND_ORIGIN=http://127.0.0.1:3000
FRONTEND_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:3001,http://localhost:3001

CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_PUBSUB_AUDIENCE=
GOOGLE_PUBSUB_SERVICE_ACCOUNT_EMAIL=
GEMINI_API_KEY=
