{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cloudflare-backend",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-25",
  "vars": {
    "FRONTEND_ORIGIN": "https://gpayanalyze.co.in",
    "FRONTEND_ORIGINS": "https://gpayanalyze.co.in,http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001",
    "GOOGLE_OAUTH_REDIRECT_URI": "https://api.gpayanalyze.co.in/oauth2callback",
    "GOOGLE_PUBSUB_TOPIC_NAME": "projects/directed-graph-394817/topics/gpay-cost-analyser-gmail",
    "HDFC_SENDERS": "alerts@hdfcbank.net,alerts@hdfcbank.bank.in",
    "GOOGLE_GEMINI_MODEL": "gemini-2.5-flash-lite-preview-06-17"
  },
  "r2_buckets": [
    {
      "binding": "TRANSACTIONS_BUCKET",
      "bucket_name": "cost-analyser"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gpay-cost-analyser",
      "database_id": "3814b2ed-cc4f-4010-805b-52e53bde087a",
      "migrations_dir": "migrations"
    }
  ],
  "routes": [
    {
      "pattern": "api.gpayanalyze.co.in",
      "custom_domain": true
    }
  ],
  "triggers": {
    "crons": [
      "0 2 * * *",
      "0 * * * *"
    ]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
